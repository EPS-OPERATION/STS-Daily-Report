NODE_ENV=development

WEB_PORT=5173
API_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sts
# Hosted: migrations over a session-capable URL (Supabase session pooler :5432 / direct); runtime uses the :6543 pooler.
# MIGRATE_DATABASE_URL=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sts
MINIO_USE_SSL=false

WEB_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
SESSION_COOKIE_NAME=sts_session
SESSION_TTL_HOURS=24

# Dev API URL. Production builds default to the same origin (/api/v1) when this is unset.
VITE_API_URL=http://localhost:3000/api/v1

# Trial mode: contractors can re-send reports any number of times (default false)
ALLOW_RESUBMIT=false

# Hourly site weather pull in the API (default true). CRON_SECRET (16+ chars) enables
# POST /api/v1/internal/weather/sync for an external hourly scheduler.
WEATHER_CRON=true
# CRON_SECRET=
# bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# First EPS administrator (no users are seeded). Set both vars for one command:
# EPS_BOOTSTRAP_EMAIL=you@company.com EPS_BOOTSTRAP_PASSWORD=<8-128 chars> bun apps/api/scripts/bootstrap-admin.ts
