NODE_ENV=development

WEB_PORT=5173
API_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sts

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sts
MINIO_USE_SSL=false

AUTH_PROVIDER=password
WEB_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
# Optional legacy seeded-demo login; leave disabled for normal production.
ALLOW_DEMO_LOGIN=false
# DEMO_ACCESS_CODE=configure-in-your-local-or-hosted-environment
SESSION_COOKIE_NAME=sts_session
SESSION_TTL_HOURS=24

VITE_API_URL=http://localhost:3000/api/v1

# Trial mode: contractors can re-send reports any number of times (default false)
ALLOW_RESUBMIT=false
