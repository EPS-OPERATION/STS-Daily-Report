# Copy to .env.prod (never commit it). Used with: docker compose --env-file .env.prod -f compose.prod.yml ...
APP_DOMAIN=sts.example.com
FILES_DOMAIN=files.example.com

POSTGRES_PASSWORD=change-me-long-random
MINIO_ROOT_USER=sts-minio
MINIO_ROOT_PASSWORD=change-me-long-random

# Optional monitoring (leave blank to keep it off). The DSNs come from Sentry, GlitchTip or Bugsink (same protocol):
# SENTRY_DSN=            # API errors
# SENTRY_WEB_DSN=        # browser errors (baked into the web image: rebuild after changing it)
# SENTRY_CSP_ORIGIN=     # origin of the tracker for the web CSP, e.g. https://errors.example.com
# WEATHER_HEARTBEAT_URL= # Healthchecks.io ping URL for the hourly weather job

# Optional: enables POST /api/v1/internal/weather/sync (the built-in hourly job already runs on a VPS).
# CRON_SECRET=
