# STS API image for Vercel (container service in vercel.json). Same as Dockerfile,
# but production mode on port 80 (Vercel's default container port). Password login only.
FROM oven/bun:1.3 AS runtime
WORKDIR /app

# Workspace manifests first for layer caching (Bun requires every
# workspace package.json to match the lockfile).
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/env/package.json ./packages/env/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/typescript-config/package.json ./packages/typescript-config/package.json
RUN bun install --frozen-lockfile

COPY packages ./packages
COPY apps/api ./apps/api
WORKDIR /app/apps/api

ENV NODE_ENV=production
ENV API_PORT=80
EXPOSE 80
CMD ["bun", "src/index.ts"]
