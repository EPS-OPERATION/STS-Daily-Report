{
  "name": "sts-daily-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose --profile app up -d --build --wait api && bun run dev:web",
    "dev:web": "bun --filter ./apps/web dev",
    "dev:api": "bun --env-file=.env --filter ./apps/api dev",
    "build": "bun run build:api && bun run build:web",
    "build:web": "bun --filter ./apps/web build",
    "build:api": "bun --filter ./apps/api build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "bun test",
    "db:generate": "bun --env-file=.env --filter ./apps/api db:generate",
    "db:migrate": "bun --env-file=.env --filter ./apps/api db:migrate",
    "db:push": "bun --env-file=.env --filter ./apps/api db:push",
    "db:studio": "bun --env-file=.env --filter ./apps/api db:studio",
    "db:seed": "bun --env-file=.env --filter ./apps/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "konva": "^10.7.0",
    "react-konva": "^19.3.0"
  }
}
