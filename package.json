{
  "name": "sts-daily-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "bun --filter ./apps/web dev",
    "dev:api": "bun --filter ./apps/api dev",
    "build": "bun run build:api && bun run build:web",
    "build:web": "bun --filter ./apps/web build",
    "build:api": "bun --filter ./apps/api build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "echo \"lint: no eslint config yet (see agent.md)\" && exit 0",
    "db:generate": "bun --filter ./apps/api db:generate",
    "db:migrate": "bun --filter ./apps/api db:migrate",
    "db:push": "bun --filter ./apps/api db:push",
    "db:studio": "bun --filter ./apps/api db:studio",
    "db:seed": "bun --filter ./apps/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "konva": "^10.7.0",
    "react-konva": "^19.3.0",
    "sts-web": "./apps/web"
  }
}
