# Copy to .env.backup on the server (never commit it). scripts/backup.sh and scripts/restore-check.sh read it as shell
# syntax, so keep the quotes. Without this file, backups stay on the server. Setup: docs/deployment.md §4.

# Encrypted offsite repository (restic). Cloudflare R2 example; for Backblaze B2 use
# s3:https://s3.<region>.backblazeb2.com/<bucket>/sts and a B2 application key.
RESTIC_REPOSITORY="s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/sts"
# Losing this passphrase means losing every backup: keep a copy in the team password manager.
RESTIC_PASSWORD="change-me-long-random"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"

# Retention of offsite snapshots (defaults shown).
# RESTIC_KEEP_DAILY=14
# RESTIC_KEEP_WEEKLY=8
# RESTIC_KEEP_MONTHLY=6

# Healthchecks.io-style URLs: the backup pings start/success (and /fail), the drill pings its own check.
# A check that stops receiving pings sends the alert.
HC_PING_URL=""
HC_RESTORE_PING_URL=""
